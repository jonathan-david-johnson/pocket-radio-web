{
  "name": "pocket-radio-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "wrangler pages dev dist --local --local-protocol https --ip 127.0.0.1 --port 8788",
    "dev:web": "vite --host 127.0.0.1",
    "test": "vitest run && pnpm run test:db && pnpm run test:runtime && pnpm run test:bundle",
    "test:unit": "vitest run",
    "test:db": "node --test tests/auth/database.test.mjs tests/auth/interleavings.test.mjs tests/stations/database.test.mjs",
    "test:runtime": "node tests/pages-runtime.mjs",
    "test:bundle": "node tests/bundle-scan.mjs",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.functions.json && tsc -p tsconfig.node.json && tsc -p tsconfig.ui-tests.json",
    "build": "vite build && wrangler pages functions build --outdir .wrangler/functions",
    "deploy": "wrangler pages deploy dist --project-name \"$PAGES_PROJECT\" --branch main"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261011.1",
    "@electric-sql/pglite": "0.5.8",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "miniflare": "5.20261006.1-alpha",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
